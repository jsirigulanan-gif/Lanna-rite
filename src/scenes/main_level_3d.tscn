[node name="LoreDoc" parent="Environment" instance=ExtResource("8_loredoc")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 13.5, 0, 7.5)
document_title = "บันทึกครูเวร (14 พ.ย.)"
document_content = "วันที่ 14 พฤศจิกายน... หลังจากเสียงระฆังเลิกเรียน หมอกควันประหลาดเริ่มลอยลงมาจากยอดดอย ผู้ใหญ่ในหมู่บ้านต่างพากันปิดประตูเรือนเงียบกริบ ฉันได้ยินเสียงสวดมนต์ภาษากลางเมืองล้านนาโบราณแว่วมาจากลานศาลผีปู่ย่า... วิญญาณบรรพบุรุษกำลังตื่นขึ้นมาทวงถามบางสิ่ง..."

