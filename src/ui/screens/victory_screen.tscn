theme_override_colors/font_color = Color(0.85, 0.85, 0.9, 1)
theme_override_font_sizes/font_size = 14
text = "สองพี่น้องสามารถทำลายเครื่องเซ่นและดับไฟพิธีกรรมได้สำเร็จ... แสงอาทิตย์แรกแห่งหุบเขาสาดส่องขับไล่หมอกอาถรรพ์และวิญญาณร้ายให้สลายไป ทั้งคู่พากันก้าวพ้นประตูหมู่บ้านสู่ความปลอดภัย"
